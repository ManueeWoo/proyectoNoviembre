<link rel="stylesheet" href="/assets/css/solicitudes.css">

<section class="solicitud">
    <h1 class="sTitulo">Mis solicitudes</h1>
    <p class="sSubTitulo">Gestiona las solicitudes que has recibido y las que has enviado.</p>

    <div class="sEnviadasRecibidas">
        <button type="button" class="sOpcion activo" data-rol="recibidas">Recibidas</button>
        <button type="button" class="sOpcion" data-rol="enviadas">Enviadas</button>
    </div>

    <div class="sPestañas">
        <button type="button" class="sPestaña activo" data-estado="pendientes">Pendientes</button>
        <button type="button" class="sPestaña" data-estado="curso">En curso</button>
        <button type="button" class="sPestaña" data-estado="cerradas">Finalizadas</button>
    </div>

    <p class="sAviso" id="aviso">Cargando solicitudes...</p>
    <div class="sLista" id="lista"></div>
</section>

<div hidden>
    <article class="sFila" id="molde">
        <img class="sFoto" alt="">
        <div class="sInfo">
            <h2 class="sNombre"></h2>
            <p class="sTexto sPersona"></p>
            <p class="sTexto sDesc"></p>
            <span class="sEstado"></span>
        </div>
        <div class="sPuntos">
            <strong class="sNumero"></strong>
            <span>puntos</span>
        </div>
        <div class="sAcciones">
            <button type="button" class="sBtn sBtnok sol__ped-rec" data-accion="aceptar">Aceptar</button>
            <button type="button" class="sBtn sBtnNo sol__ped-rec" data-accion="rechazar">Rechazar</button>
            <button type="button" class="sBtn sBtnNo sol__ped-env" data-accion="cancelar">Cancelar</button>
            <button type="button" class="sBtn sBtnok sFinalizar" data-accion="finalizar">Marcar como finalizado</button>
            <span class="sEsperando">Esperando a la otra parte</span>
            <a class="sBtn sOtro sVer">Ver oferta</a>
        </div>
    </article>
</div>