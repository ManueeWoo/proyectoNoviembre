{% extends 'layout.html.twig' %}
{% block estilo %}
{{parent()}}
<link rel="stylesheet" href="/assets/css/perfil.css">
{% endblock %}
{%block js%}
<script src="/assets/js/previewFotos/preview.js" defer></script>
{% endblock %}
{% block content %}
<div class="perfil">

  <div class="perfilFoto">
    <img id="preview"
         src="/upload/{{ usuario.foto ? usuario.foto : 'logo.png' }}"
         alt="Foto de perfil">

    <form action="" method="POST" enctype="multipart/form-data">
      <input type="file" name="foto" id="foto" accept="image/*">
      <button type="submit">Subir</button>
    </form>
  </div>
  <ul class="perfilDatos">
    <li><span>ID</span> {{ usuario.id }}</li>
    <li><span>Nombre</span> {{ usuario.nombre }}</li>
    <li><span>Alta</span> {{ usuario.alta }}</li>
    <li><span>Teléfono</span> {{ usuario.telefono }}</li>
    <li><span>Email</span> {{ usuario.email }}</li>
  </ul>

</div>
{% endblock %}