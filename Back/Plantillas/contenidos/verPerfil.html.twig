
{% extends 'layout.html.twig' %}

{% block estilo %}
  {{ parent() }}
  <link rel="stylesheet" href="/assets/css/perfil.css">
{% endblock %}

{% block js %}
  {{ parent() }}
  <script src="/assets/js/previewFotos/preview.js" defer></script>
  <script src="/assets/js/perfil/perfil.js" defer></script>
{% endblock %}

{% block content %}
<div class="perfil">

  <div class="perfilFoto">
    <img id="preview"
         src="/upload/{{ usuario.foto ? usuario.foto : 'logo.png' }}"
         alt="Foto de perfil">
  </div>

  {# VISTA NORMAL DEL PERFIL #}
  <div id="vistaPerfil" {% if editar %}hidden{% endif %}>

    <h2>{{ usuario.nombre }} {{ usuario.ap1 }} {{ usuario.ap2 }}</h2>

    <ul class="perfilDatos">
      <li><span>Teléfono</span> {{ usuario.telefono }}</li>
      <li><span>ID</span> {{ usuario.id }}</li>
      <li><span>Alta</span> {{ usuario.alta }}</li>
      <li><span>Email</span> {{ usuario.email }}</li>
    </ul>

    <button type="button" id="editarPerfil">
      Editar perfil
    </button>

  </div>

  {# FORMULARIO DE EDICIÓN #}
  <form id="formPerfil"
        class="perfilForm"
        action="/verperfil"
        method="POST"
        enctype="multipart/form-data"
        {% if not editar %}hidden{% endif %}>

    <div class="perfilCampos">

      <label>Foto de perfil</label>
      <input type="file" name="foto" id="foto" accept="image/*">

      <label>Nombre</label>
      <input type="text" name="nombre"
             value="{{ valores.nombre ?? usuario.nombre }}" required>

      <label>Primer apellido</label>
      <input type="text" name="ap1"
             value="{{ valores.ap1 ?? usuario.ap1 }}" required>

      <label>Segundo apellido</label>
      <input type="text" name="ap2"
             value="{{ valores.ap2 ?? usuario.ap2 }}">

      <label>Teléfono</label>
      <input type="tel" name="telefono"
             value="{{ valores.telefono ?? usuario.telefono }}" required>

      {% if errores %}
        {% for error in errores %}
          <p class="error">{{ error }}</p>
        {% endfor %}
      {% endif %}

      <div class="perfilBotones">
        <button type="submit">Guardar cambios</button>
        <button type="button" id="cancelarEdicion">Cancelar</button>
      </div>

    </div>
  </form>

</div>
{% endblock %}
