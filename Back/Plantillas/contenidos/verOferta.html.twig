{% extends 'layout.html.twig' %}

{% block js %}
{{parent()}}
<script src="/assets/js/solicitud/LogicaSolicitud.js" defer></script>
{% endblock %}

{% block content %}
<section class="detalle">

  <div class="detalle__cols">

    <article class="detalle__principal">
      <h1 class="detalle__titulo">Ofrezco {{ oferta.servicio.titulo }}</h1>

      <p class="detalle__estado {{ oferta.activo ? 'detalle__estado--ok' : 'detalle__estado--no' }}">
        {{ oferta.activo ? 'Disponible' : 'No disponible' }}
      </p>

      <div class="detalle__datos">
        <div>
          <span>Puntos</span>
          <strong>{{ oferta.puntos }}</strong>
        </div>
        <div>
          <span>Tiempo estimado</span>
          <strong>{{ oferta.tiempoEstimado }} min</strong>
        </div>
      </div>

      <h2 class="detalle__subtitulo">Descripción</h2>
      <p class="detalle__desc">{{ oferta.descripcion }}</p>
    </article>

    <aside class="detalle__lateral">
      <div class="usuario">
        <div class="usuario__cabecera">
          <img class="usuario__foto"
               src="/upload/{{ oferta.usuario.foto ? oferta.usuario.foto : 'logo.png' }}"
               alt="Foto de {{ oferta.usuario.nombre }}">
          <div>
            <p class="usuario__nombre">{{ oferta.usuario.nombre }}</p>
            <p class="usuario__alta">Miembro desde {{ oferta.usuario.alta|date('m/Y') }}</p>
          </div>
        </div>
        <form action="/api/solicitud" method="post">
          <button id="solicitar" class="boton boton--principal" type="button"
          data-oferta="{{ oferta.id }}">Solicitar</button>
        <p id="solicitudMsg"></p>
        </form>
        <a class="boton" href="/ofertas/usuario/{{ oferta.usuario.id }}">Ver sus ofertas</a>
      </div>
    </aside>

  </div>
</section>
{% endblock %}