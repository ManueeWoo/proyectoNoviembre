{% extends 'layout.html.twig' %}

{% block estilo %}
  {{ parent() }}
  <link rel="stylesheet" href="/assets/css/admin.css">
{% endblock %}

{% block content %}
<section class="admin">
  <h1 class="admin__titulo">Panel de administración</h1>

  {% if mensaje %}
    <p class="admin__aviso">{{ mensaje }}</p>
  {% endif %}

  {# ===== USUARIOS REGISTRADOS ===== #}
  <div class="admin__bloque">
    <h2>Usuarios registrados <span class="admin__contador">{{ usuarios|length }}</span></h2>

    {% if usuarios is empty %}
      <p class="admin__vacio">No hay usuarios registrados.</p>
    {% else %}
      <div class="admin__tabla-wrap">
        <table class="admin__tabla">
          <thead>
            <tr>
              <th>ID</th>
              <th>Nombre</th>
              <th>Email</th>
              <th>Teléfono</th>
              <th>Rol</th>
              <th>Alta</th>
              <th>Acciones</th>
            </tr>
          </thead>
          <tbody>
            {% for u in usuarios %}
              <tr>
                <td>{{ u.id }}</td>
                <td>{{ u.nombre }} {{ u.ap1 }} {{ u.ap2 }}</td>
                <td>{{ u.email }}</td>
                <td>{{ u.telefono }}</td>
                <td>{{ u.rol }}</td>
                <td>{{ u.alta|date('d/m/Y') }}</td>
                <td class="admin__acciones">
                  <a class="btn" href="/admin/usuarios/{{ u.id }}/editar">Editar</a>

                  {% if u.id != yo.id %}
                    <form action="/adminUsers/borrar/{{ u.id }}" method="POST">
                      <button type="submit" class="btn btn--peligro">Borrar</button>
                    </form>
                  {% endif %}
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    {% endif %}
  </div>

  {# ===== USUARIOS PENDIENTES ===== #}
  <div class="admin__bloque">
    <h2>Pendientes de aprobación <span class="admin__contador">{{ pendientes|length }}</span></h2>

    {% if pendientes is empty %}
      <p class="admin__vacio">No hay registros pendientes.</p>
    {% else %}
      <div class="admin__tabla-wrap">
        <table class="admin__tabla">
          <thead>
            <tr>
              <th>Nombre</th>
              <th>Email</th>
              <th>Teléfono</th>
              <th>Solicitud</th>
              <th>Documento</th>
              <th>Acciones</th>
            </tr>
          </thead>
          <tbody>
            {% for p in pendientes %}
              <tr>
                <td>{{ p.nombre }} {{ p.ap1 }} {{ p.ap2 }}</td>
                <td>{{ p.email }}</td>
                <td>{{ p.telefono }}</td>
                <td>{{ p.alta|date('d/m/Y') }}</td>
                <td>
                  {% if p.pdf %}
                    <a href="/public/upload/pdf/{{ p.pdf }}" target="_blank" rel="noopener">Ver PDF</a>
                  {% else %}
                    <span class="admin__vacio">Sin PDF</span>
                  {% endif %}
                </td>
                <td class="admin__acciones">
                  <form action="/adminUsers/aceptarPendiente/{{ p.id }}" method="POST">
                    <button type="submit" class="btn btn--ok">Aceptar</button>
                  </form>
                  <form action="/adminUsers/rechazarPendiente/{{ p.id }}" method="POST">
                    <button type="submit" class="btn btn--peligro">Rechazar</button>
                  </form>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    {% endif %}
  </div>
</section>
{% endblock %}